---
import AppLayout from "../../layouts/AppLayout.astro";
import { MODULES } from "../../lib/constants";
---

<AppLayout title="Historial de ventas">
	<h1>Historial de ventas</h1>

	<div class="toolbar" id="module-filter-wrap" hidden>
		<label>
			Módulo:
			<select id="module-filter">
				<option value="">Todos</option>
				{MODULES.map((m) => <option value={m.id}>{m.name}</option>)}
			</select>
		</label>
	</div>

	<p class="error" id="historial-error" hidden></p>

	<table class="card">
		<thead>
			<tr>
				<th>Fecha</th>
				<th>Módulo</th>
				<th>Vendedor</th>
				<th>Productos</th>
				<th>Medio de pago</th>
				<th>Descuento</th>
				<th>Total</th>
			</tr>
		</thead>
		<tbody id="sales-body"></tbody>
	</table>
</AppLayout>

<script>
	import { requireAuth, isPreviewMode } from "../../lib/guards";
	import { getModuleSales, getAllSales, type Sale } from "../../lib/firebase/sales";
	import { MODULES, PAYMENT_METHODS } from "../../lib/constants";
	import { MOCK_SALES } from "../../lib/mockPreviewData";
	import { escapeHtml } from "../../lib/escapeHtml";

	const errorMsg = document.getElementById("historial-error") as HTMLParagraphElement;

	function moduleName(id: string) {
		return MODULES.find((m) => m.id === id)?.name ?? id;
	}

	function paymentName(id: string) {
		return PAYMENT_METHODS.find((m) => m.id === id)?.name ?? id;
	}

	function render(sales: Sale[]) {
		const body = document.getElementById("sales-body") as HTMLTableSectionElement;
		body.innerHTML = "";
		for (const sale of sales) {
			const date = sale.createdAt?.toDate ? sale.createdAt.toDate() : new Date();
			const itemsSummary = sale.items.map((i) => `${i.qty}× ${escapeHtml(i.productName)}`).join(", ");
			const row = document.createElement("tr");
			row.innerHTML = `
				<td>${date.toLocaleString("es-CL")}</td>
				<td>${escapeHtml(moduleName(sale.moduleId))}</td>
				<td>${escapeHtml(sale.sellerName)}</td>
				<td>${itemsSummary}</td>
				<td>${escapeHtml(paymentName(sale.paymentMethod))}</td>
				<td>${sale.discount ? `-$${sale.discount.toLocaleString("es-CL")}` : "—"}</td>
				<td>$${sale.total.toLocaleString("es-CL")}</td>
			`;
			body.appendChild(row);
		}
	}

	requireAuth().then(({ claims }) => {
		if (isPreviewMode()) {
			if (claims.role === "admin") {
				const wrap = document.getElementById("module-filter-wrap") as HTMLDivElement;
				wrap.hidden = false;
				const select = document.getElementById("module-filter") as HTMLSelectElement;
				select.addEventListener("change", () => {
					render(select.value ? MOCK_SALES.filter((s) => s.moduleId === select.value) : MOCK_SALES);
				});
				render(MOCK_SALES);
			} else {
				render(MOCK_SALES.filter((s) => s.moduleId === claims.moduleId));
			}
			return;
		}

		if (claims.role === "admin") {
			const wrap = document.getElementById("module-filter-wrap") as HTMLDivElement;
			wrap.hidden = false;
			const select = document.getElementById("module-filter") as HTMLSelectElement;

			async function load() {
				errorMsg.hidden = true;
				try {
					if (select.value) {
						render(await getModuleSales(select.value));
					} else {
						render(await getAllSales());
					}
				} catch {
					errorMsg.textContent = "No se pudo cargar el historial de ventas.";
					errorMsg.hidden = false;
				}
			}
			select.addEventListener("change", load);
			load();
		} else if (claims.moduleId) {
			getModuleSales(claims.moduleId)
				.then(render)
				.catch(() => {
					errorMsg.textContent = "No se pudo cargar el historial de ventas.";
					errorMsg.hidden = false;
				});
		}
	});
</script>

<style>
	.toolbar {
		margin-bottom: 1rem;
	}

	.toolbar label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-dim);
	}
</style>
