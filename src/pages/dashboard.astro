---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Inicio">
	<h1>Hola 👋</h1>
	<p id="greeting" class="dim">Cargando...</p>

	<div class="card today-summary">
		<h2>Ventas de hoy</h2>
		<p class="today-total">Total: $<span id="today-total">0</span></p>
		<p class="payment-breakdown" id="payment-breakdown"></p>
		<table id="today-breakdown" hidden>
			<thead>
				<tr>
					<th>Módulo</th>
					<th>Ventas</th>
					<th>Total</th>
				</tr>
			</thead>
			<tbody id="today-breakdown-body"></tbody>
		</table>
	</div>

	<div class="card shift-status" id="shift-status" hidden>
		<h2>Turno de hoy</h2>
		<table>
			<thead>
				<tr>
					<th>Módulo</th>
					<th>Vendedor</th>
					<th>Estado</th>
				</tr>
			</thead>
			<tbody id="shift-status-body"></tbody>
		</table>
	</div>

	<div class="grid">
		<a class="card link" href={`${import.meta.env.BASE_URL}ventas`}>
			<h3>Registrar venta</h3>
			<p>Vende productos y descuenta stock automáticamente.</p>
		</a>
		<a class="card link" href={`${import.meta.env.BASE_URL}inventario`}>
			<h3>Inventario</h3>
			<p>Revisa y ajusta el stock de tu módulo.</p>
		</a>
		<a class="card link" href={`${import.meta.env.BASE_URL}ventas/historial`}>
			<h3>Historial de ventas</h3>
			<p>Revisa las ventas registradas.</p>
		</a>
		<a class="card link" id="productos-link" href={`${import.meta.env.BASE_URL}productos`} data-admin-only hidden>
			<h3>Productos</h3>
			<p>Administra el catálogo (solo admin).</p>
		</a>
	</div>
</AppLayout>

<script>
	import { requireAuth, isPreviewMode } from "../lib/guards";
	import { MODULES, PAYMENT_METHODS } from "../lib/constants";
	import { watchModuleSalesToday, watchAllSalesToday, type Sale } from "../lib/firebase/sales";
	import { watchWeekShifts, watchDayAttendance, todayString, type Shift, type AttendanceEvent } from "../lib/firebase/schedule";
	import { MOCK_SHIFTS } from "../lib/mockPreviewData";
	import { escapeHtml } from "../lib/escapeHtml";

	const todayTotal = document.getElementById("today-total") as HTMLSpanElement;
	const paymentBreakdown = document.getElementById("payment-breakdown") as HTMLParagraphElement;
	const breakdownTable = document.getElementById("today-breakdown") as HTMLTableElement;
	const breakdownBody = document.getElementById("today-breakdown-body") as HTMLTableSectionElement;

	const shiftStatusCard = document.getElementById("shift-status") as HTMLDivElement;
	const shiftStatusBody = document.getElementById("shift-status-body") as HTMLTableSectionElement;
	let todayShifts: Shift[] = [];
	let attendanceByModule: Record<string, AttendanceEvent[]> = {};

	function statusForSeller(sellerId: string, moduleId: string): string {
		const events = (attendanceByModule[moduleId] ?? []).filter((e) => e.sellerId === sellerId);
		const last = events[events.length - 1];
		if (!last) return "Sin marcar";
		switch (last.event) {
			case "llegada":
				return "Presente";
			case "colacion_salida":
				return "En colación";
			case "colacion_vuelta":
				return "Presente";
			case "salida":
				return "Salió";
			default:
				return "Sin marcar";
		}
	}

	function renderShiftStatus() {
		const rows = todayShifts
			.slice()
			.sort((a, b) => a.moduleId.localeCompare(b.moduleId) || a.sellerName.localeCompare(b.sellerName));
		if (rows.length === 0) {
			shiftStatusBody.innerHTML = `<tr><td colspan="3" class="dim">Nadie tiene turno asignado hoy.</td></tr>`;
			return;
		}
		shiftStatusBody.innerHTML = rows
			.map((shift) => {
				const moduleName = MODULES.find((m) => m.id === shift.moduleId)?.name ?? shift.moduleId;
				const status = statusForSeller(shift.sellerId, shift.moduleId);
				return `
					<tr>
						<td>${escapeHtml(moduleName)}</td>
						<td>${escapeHtml(shift.sellerName)}</td>
						<td>${escapeHtml(status)}</td>
					</tr>
				`;
			})
			.join("");
	}

	function renderPaymentBreakdown(sales: Sale[]) {
		const parts = PAYMENT_METHODS.map((m) => {
			const total = sales.filter((s) => s.paymentMethod === m.id).reduce((sum, s) => sum + s.total, 0);
			return total > 0 ? `${m.name}: $${total.toLocaleString("es-CL")}` : null;
		}).filter(Boolean);
		paymentBreakdown.textContent = parts.length ? parts.join(" · ") : "Sin ventas todavía.";
	}

	function renderModuleTotal(sales: Sale[]) {
		const total = sales.reduce((sum, s) => sum + s.total, 0);
		todayTotal.textContent = total.toLocaleString("es-CL");
		renderPaymentBreakdown(sales);
	}

	function renderAllTotals(sales: Sale[]) {
		const total = sales.reduce((sum, s) => sum + s.total, 0);
		todayTotal.textContent = total.toLocaleString("es-CL");
		renderPaymentBreakdown(sales);

		breakdownTable.hidden = false;
		breakdownBody.innerHTML = "";
		for (const m of MODULES) {
			const moduleSales = sales.filter((s) => s.moduleId === m.id);
			const moduleTotal = moduleSales.reduce((sum, s) => sum + s.total, 0);
			const row = document.createElement("tr");
			row.innerHTML = `
				<td>${m.name}</td>
				<td>${moduleSales.length}</td>
				<td>$${moduleTotal.toLocaleString("es-CL")}</td>
			`;
			breakdownBody.appendChild(row);
		}
	}

	requireAuth().then(({ claims }) => {
		const greeting = document.getElementById("greeting");
		if (greeting) {
			if (claims.role === "admin") {
				greeting.textContent = "Ves los 4 módulos.";
			} else {
				const moduleName = MODULES.find((m) => m.id === claims.moduleId)?.name;
				greeting.textContent = `Estás en ${moduleName ?? "tu módulo"}.`;
			}
		}

		if (isPreviewMode()) {
			if (claims.role === "admin") {
				renderAllTotals([
					{ moduleId: "plaza-sol", total: 45000, paymentMethod: "transferencia" } as Sale,
					{ moduleId: "centro", total: 32000, paymentMethod: "efectivo" } as Sale,
					{ moduleId: "centro", total: 18000, paymentMethod: "transbank" } as Sale,
				]);
				shiftStatusCard.hidden = false;
				todayShifts = MOCK_SHIFTS;
				attendanceByModule = {
					"plaza-sol": [{ sellerId: "s1", event: "llegada" } as AttendanceEvent],
					"plaza-punto": [{ sellerId: "s2", event: "colacion_salida" } as AttendanceEvent],
				};
				renderShiftStatus();
			} else {
				renderModuleTotal([
					{ total: 15000, paymentMethod: "efectivo" } as Sale,
					{ total: 10000, paymentMethod: "transferencia" } as Sale,
				]);
			}
			return;
		}

		if (claims.role === "admin") {
			watchAllSalesToday(renderAllTotals);

			shiftStatusCard.hidden = false;
			const today = todayString();
			watchWeekShifts(today, today, (shifts) => {
				todayShifts = shifts;
				renderShiftStatus();
			});
			for (const m of MODULES) {
				watchDayAttendance(m.id, today, (events) => {
					attendanceByModule[m.id] = events;
					renderShiftStatus();
				});
			}
		} else if (claims.moduleId) {
			watchModuleSalesToday(claims.moduleId, renderModuleTotal);
		}
	});
</script>

<style>
	.dim {
		color: var(--text-dim);
	}

	.today-summary,
	.shift-status {
		margin-top: 1rem;
	}

	.shift-status h2 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.today-summary h2 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.today-total {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.payment-breakdown {
		color: var(--text-dim);
		font-size: 0.9rem;
		margin: 0 0 0.75rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.link h3 {
		margin: 0 0 0.4rem;
		color: var(--accent);
	}

	.link p {
		margin: 0;
		color: var(--text-dim);
		font-size: 0.9rem;
	}
</style>
