---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Inicio">
	<h1>Hola 👋</h1>
	<p id="greeting" class="dim">Cargando...</p>

	<div class="card today-summary">
		<h2>Ventas de hoy</h2>
		<p class="today-total">Total: $<span id="today-total">0</span></p>
		<p class="payment-breakdown" id="payment-breakdown"></p>
		<table id="today-breakdown" hidden>
			<thead>
				<tr>
					<th>Módulo</th>
					<th>Ventas</th>
					<th>Total</th>
				</tr>
			</thead>
			<tbody id="today-breakdown-body"></tbody>
		</table>
	</div>

	<div class="grid">
		<a class="card link" href={`${import.meta.env.BASE_URL}ventas`}>
			<h3>Registrar venta</h3>
			<p>Vende productos y descuenta stock automáticamente.</p>
		</a>
		<a class="card link" href={`${import.meta.env.BASE_URL}inventario`}>
			<h3>Inventario</h3>
			<p>Revisa y ajusta el stock de tu módulo.</p>
		</a>
		<a class="card link" href={`${import.meta.env.BASE_URL}ventas/historial`}>
			<h3>Historial de ventas</h3>
			<p>Revisa las ventas registradas.</p>
		</a>
		<a class="card link" id="productos-link" href={`${import.meta.env.BASE_URL}productos`} data-admin-only hidden>
			<h3>Productos</h3>
			<p>Administra el catálogo (solo admin).</p>
		</a>
	</div>
</AppLayout>

<script>
	import { requireAuth, isPreviewMode } from "../lib/guards";
	import { MODULES, PAYMENT_METHODS } from "../lib/constants";
	import { watchModuleSalesToday, watchAllSalesToday, type Sale } from "../lib/firebase/sales";

	const todayTotal = document.getElementById("today-total") as HTMLSpanElement;
	const paymentBreakdown = document.getElementById("payment-breakdown") as HTMLParagraphElement;
	const breakdownTable = document.getElementById("today-breakdown") as HTMLTableElement;
	const breakdownBody = document.getElementById("today-breakdown-body") as HTMLTableSectionElement;

	function renderPaymentBreakdown(sales: Sale[]) {
		const parts = PAYMENT_METHODS.map((m) => {
			const total = sales.filter((s) => s.paymentMethod === m.id).reduce((sum, s) => sum + s.total, 0);
			return total > 0 ? `${m.name}: $${total.toLocaleString("es-CL")}` : null;
		}).filter(Boolean);
		paymentBreakdown.textContent = parts.length ? parts.join(" · ") : "Sin ventas todavía.";
	}

	function renderModuleTotal(sales: Sale[]) {
		const total = sales.reduce((sum, s) => sum + s.total, 0);
		todayTotal.textContent = total.toLocaleString("es-CL");
		renderPaymentBreakdown(sales);
	}

	function renderAllTotals(sales: Sale[]) {
		const total = sales.reduce((sum, s) => sum + s.total, 0);
		todayTotal.textContent = total.toLocaleString("es-CL");
		renderPaymentBreakdown(sales);

		breakdownTable.hidden = false;
		breakdownBody.innerHTML = "";
		for (const m of MODULES) {
			const moduleSales = sales.filter((s) => s.moduleId === m.id);
			const moduleTotal = moduleSales.reduce((sum, s) => sum + s.total, 0);
			const row = document.createElement("tr");
			row.innerHTML = `
				<td>${m.name}</td>
				<td>${moduleSales.length}</td>
				<td>$${moduleTotal.toLocaleString("es-CL")}</td>
			`;
			breakdownBody.appendChild(row);
		}
	}

	requireAuth().then(({ claims }) => {
		const greeting = document.getElementById("greeting");
		if (greeting) {
			if (claims.role === "admin") {
				greeting.textContent = "Ves los 4 módulos.";
			} else {
				const moduleName = MODULES.find((m) => m.id === claims.moduleId)?.name;
				greeting.textContent = `Estás en ${moduleName ?? "tu módulo"}.`;
			}
		}

		if (isPreviewMode()) {
			if (claims.role === "admin") {
				renderAllTotals([
					{ moduleId: "plaza-sol", total: 45000, paymentMethod: "transferencia" } as Sale,
					{ moduleId: "centro", total: 32000, paymentMethod: "efectivo" } as Sale,
					{ moduleId: "centro", total: 18000, paymentMethod: "transbank" } as Sale,
				]);
			} else {
				renderModuleTotal([
					{ total: 15000, paymentMethod: "efectivo" } as Sale,
					{ total: 10000, paymentMethod: "transferencia" } as Sale,
				]);
			}
			return;
		}

		if (claims.role === "admin") {
			watchAllSalesToday(renderAllTotals);
		} else if (claims.moduleId) {
			watchModuleSalesToday(claims.moduleId, renderModuleTotal);
		}
	});
</script>

<style>
	.dim {
		color: var(--text-dim);
	}

	.today-summary {
		margin-top: 1rem;
	}

	.today-summary h2 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
	}

	.today-total {
		font-size: 1.5rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.payment-breakdown {
		color: var(--text-dim);
		font-size: 0.9rem;
		margin: 0 0 0.75rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.link {
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.link h3 {
		margin: 0 0 0.4rem;
		color: var(--accent);
	}

	.link p {
		margin: 0;
		color: var(--text-dim);
		font-size: 0.9rem;
	}
</style>
