rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function myModule() { return request.auth.token.moduleId; }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isModule(moduleId) { return isSignedIn() && role() == 'module' && myModule() == moduleId; }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /stock/{productId} {
        allow read: if isAdmin() || isModule(moduleId);
        allow write: if (isAdmin() || isModule(moduleId))
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity >= 0;
      }

      match /sales/{saleId} {
        allow read, create: if isAdmin() || isModule(moduleId);
        allow update, delete: if isAdmin();
      }

      match /movements/{movementId} {
        allow read, create: if isAdmin() || isModule(moduleId);
        allow update, delete: if isAdmin();
      }

      match /asistencia/{eventId} {
        allow read, create: if isAdmin() || isModule(moduleId);
        allow update, delete: if isAdmin();
      }
    }

    // Admin cross-module views (collection group queries)
    match /{path=**}/sales/{saleId} {
      allow read: if isAdmin();
    }
    match /{path=**}/stock/{productId} {
      allow read: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sellers rotate across every module, so the roster and schedule are global.
    match /sellers/{sellerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /turnos/{turnoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      allow write: if false; // only the Admin SDK provisioning script touches this
    }
  }
}
