rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function myModule() { return request.auth.token.moduleId; }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isModule(moduleId) { return isSignedIn() && role() == 'module' && myModule() == moduleId; }

    // Firestore rules can't sum an array (no reduce/loop), so this can't re-derive `total`
    // from `items` + `discount` — but it still blocks impersonation, wrong-shaped docs and
    // negative/garbage numbers, which is what a client-side-only check can't enforce.
    function validSale(data, moduleId) {
      return data.moduleId == moduleId
        && data.createdByUid == request.auth.uid
        && data.sellerId is string && data.sellerId.size() > 0
        && data.sellerName is string && data.sellerName.size() > 0
        && data.items is list && data.items.size() > 0
        && data.discount is number && data.discount >= 0
        && data.total is number && data.total >= 0
        && data.paymentMethod in ['transferencia', 'transbank', 'efectivo', 'mixto', 'rapid']
        && data.createdAt is timestamp;
    }

    function validMerma(data) {
      return data.type == 'merma'
        && data.createdByUid == request.auth.uid
        && data.productId is string && data.productId.size() > 0
        && data.productName is string && data.productName.size() > 0
        && data.qty is number && data.qty > 0
        && data.reason is string && data.reason.size() > 0
        && data.createdAt is timestamp;
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /stock/{productId} {
        allow read: if isAdmin() || isModule(moduleId);
        allow write: if (isAdmin() || isModule(moduleId))
                      && request.resource.data.quantity is int
                      && request.resource.data.quantity >= 0;
      }

      match /sales/{saleId} {
        allow read: if isAdmin() || isModule(moduleId);
        allow create: if (isAdmin() || isModule(moduleId)) && validSale(request.resource.data, moduleId);
        allow update, delete: if isAdmin();
      }

      match /movements/{movementId} {
        allow read: if isAdmin() || isModule(moduleId);
        allow create: if (isAdmin() || isModule(moduleId)) && validMerma(request.resource.data);
        allow update, delete: if isAdmin();
      }

      match /asistencia/{eventId} {
        allow read, create: if isAdmin() || isModule(moduleId);
        allow update, delete: if isAdmin();
      }
    }

    // Admin cross-module views (collection group queries)
    match /{path=**}/sales/{saleId} {
      allow read: if isAdmin();
    }
    match /{path=**}/stock/{productId} {
      allow read: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sellers rotate across every module, so the roster and schedule are global.
    match /sellers/{sellerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /turnos/{turnoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == uid);
      allow write: if false; // only the Admin SDK provisioning script touches this
    }
  }
}
